# ESP-NOW AT interpreter - ESP32-C6 overrides.
#
# ESP-IDF applies this file automatically on top of sdkconfig.defaults when
# IDF_TARGET is esp32c6 (see tools/cmake/kconfig.cmake).
#
# The AT link (UART1) is wired to GPIO16/17 on this board - which are also
# the ESP32-C6's DEFAULT UART0 console pins. Left alone, the boot/log output
# on UART0 drives GPIO16 at the same time as the AT UART, corrupting the AT
# stream. Move the console TX to GPIO2 so the two never share a pin.
#
# Console RX is parked on GPIO4 (unused in this design) rather than the chip
# default (GPIO17), which is the AT UART RX pin - the console must not tap the
# AT input line. This firmware never reads console stdin, so GPIO4 just needs
# to be a free pin.
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_0=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_TX_GPIO=2
CONFIG_ESP_CONSOLE_UART_RX_GPIO=4
