# ESP-NOW AT interpreter - ESP32-C3 overrides.
#
# ESP-IDF applies this file automatically on top of sdkconfig.defaults when
# IDF_TARGET is esp32c3 (see tools/cmake/kconfig.cmake).
#
# The AT link (UART1) is wired to GPIO21(TX)/GPIO20(RX) on this board - which
# are also the ESP32-C3's DEFAULT UART0 console pins. Left alone, the boot/log
# output on UART0 drives those pins at the same time as the AT UART, corrupting
# the AT stream. Move the console TX to GPIO18 and RX to GPIO19 (both unused in
# this design) so the console and the AT link never share a pin. This firmware
# never reads console stdin, so the console RX pin just needs to be free.
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_0=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_TX_GPIO=18
CONFIG_ESP_CONSOLE_UART_RX_GPIO=19
